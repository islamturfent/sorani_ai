# ===========================================================================
# SORANI AI CALL CENTER - Environment Configuration
# Copy to `.env` and adjust. NEVER commit real secrets.
# ===========================================================================

# --- App ---
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
TZ=Asia/Erbil

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://sorani:sorani@localhost:5432/sorani?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Multi-tenancy ---
DEFAULT_TENANT_ID=platform
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# --- LLM Provider (LM Studio / OpenAI-compatible) ---
LLM_PROVIDER=lm-studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=sorani-agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet

# --- STT Provider ---
# mock | kurdishtts | openai-whisper
STT_PROVIDER=kurdishtts
OPENAI_STT_MODEL=whisper-1
# Sorani speech recognition (kurdishtts.com) — paste the STT key here
KURDISH_STT_API_KEY=

# --- TTS Provider ---
# mock | kurdishtts | elevenlabs | azure
TTS_PROVIDER=kurdishtts
TTS_VOICE_ID=sorani-female-rojin

# Kurdish TTS (kurdishtts.com) — native female Sorani voice. Free tier.
# Generate a free TTS API key at https://www.kurdishtts.com/settings/api
KURDISH_TTS_API_KEY=
# Female 1 Sorani voice; 113 female Sorani speakers available in /api/get-speakers
KURDISH_TTS_SPEAKER_ID=sorani_986
KURDISH_TTS_MODEL=v4

# ElevenLabs — requires a paid plan to use library voices via the API
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Azure Speech — fallback female Arabic/Sorani neural voice
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_TTS_VOICE=ar-SA-HudaNeural

# --- Telephony Provider ---
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Encryption (secrets at rest) ---
ENCRYPTION_KEY=change-me-32-bytes-minimum-secret-key-0000

# --- Webhooks ---
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# --- Mock providers behaviour ---
MOCK_LATENCY_MS=50
MOCK_RESERVATION_FAILURE_RATE=0.1

# --- Simulation ---
SIMULATION_USE_MIC=true
